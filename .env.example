# Every variable here is optional. The service runs with no configuration at all.

# --- Credentials ---
# Leave API_KEY unset to have one generated on first boot and stored in the data
# volume; it is printed once in the log. Set it to pin your own.
API_KEY=
# Read-only token for the plain-text list, usable as ?token=... by consumers that
# cannot send headers. Empty disables it.
LIST_TOKEN=

# --- Validation ---
INTERVAL_SECONDS=1200          # seconds between full revalidations
MAX_LATENCY_SECONDS=5.0        # health cutoff: slower proxies are discarded
VALIDATOR_WORKERS=100          # concurrent validation threads
# PROXY_SOURCES=https://...,https://...   # override the built-in source list

# --- Geolocation ---
GEOLOOKUP=true                 # false disables country lookups via ip-api.com
GEOLOOKUP_MAX_IPS=500          # cap on new IPs resolved per cycle

# --- Dashboard ---
PUBLIC_DASHBOARD=true          # false requires a login to view as well
DASHBOARD_ROWS=100             # rows sent to the table
LATENCY_BUCKETS=12             # buckets in the latency histogram
SESSION_COOKIE_SECURE=false    # true sends the session cookie over HTTPS only

# --- Runtime ---
OUTPUT_FILE=/data/proxies.txt  # also decides where the rest of the state lives
PORT=8069                      # only used by `python app.py`
DISABLE_SCHEDULER=             # 1 serves the API without validating in the background
